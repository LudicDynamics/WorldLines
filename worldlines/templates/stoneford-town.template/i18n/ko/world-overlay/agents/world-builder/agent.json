{
  "id": "world-builder",
  "name": "World Builder",
  "description": "RPG 세계 구축 에이전트. 세계 지도 구조를 관리하고 새 지역을 확장하며 노드의 discovered/cleared/danger 상태를 갱신한다. 새 장소를 발견하거나 세계 지도를 갱신할 때 쓴다.",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 20,
  "triggers": [],
  "tags": [
    "world",
    "map",
    "builder"
  ],
  "priority": 30,
  "permissions": {
    "read_globs": [
      "game/world/world_map.json",
      "game/lore/story.md",
      "game/lore/notes.md",
      "game/meta/run_state.json"
    ],
    "write_globs": [
      "game/world/world_map.json"
    ],
    "deny_globs": [
      ".neonrp/**"
    ],
    "direct_write_globs": [
      "game/world/world_map.json",
      "game/world/regions.json",
      "game/world/factions.json"
    ]
  },
  "defaults": {
    "context_limit": 20,
    "temperature": 0.8
  },
  "presentation_roles": {
    "en": "System",
    "zh": "系统",
    "ja": "システム",
    "ko": "시스템"
  },
  "presentation_hidden": false
}
