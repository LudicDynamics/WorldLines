{
  "id": "world-builder",
  "name": "World Builder",
  "description": "RPG のワールド構築エージェント。ワールドマップの構造を管理し、新しい地域を広げ、ノードの discovered/cleared/danger 状態を更新する。新しい場所の発見やワールドマップの更新時に使う。",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 20,
  "triggers": [],
  "tags": [
    "world",
    "map",
    "builder"
  ],
  "priority": 30,
  "permissions": {
    "read_globs": [
      "game/world/world_map.json",
      "game/lore/story.md",
      "game/lore/notes.md",
      "game/meta/run_state.json"
    ],
    "write_globs": [
      "game/world/world_map.json"
    ],
    "deny_globs": [
      ".neonrp/**"
    ],
    "direct_write_globs": [
      "game/world/world_map.json",
      "game/world/regions.json",
      "game/world/factions.json"
    ]
  },
  "defaults": {
    "context_limit": 20,
    "temperature": 0.8
  },
  "presentation_roles": {
    "en": "System",
    "zh": "系统",
    "ja": "システム",
    "ko": "시스템"
  },
  "presentation_hidden": false
}
