     "who": "player",
     "at": "T001/guild"
    },
    {
     "text": [
      "受ける",
      "受けます",
      "引き受け",
      "請け負",
      "その依頼",
      "やります",
      "やらせて",
      "任せて",
      "俺がやる",
      "私がやる",
      "サインする"
     ],
     "in": "player"
    }
   ],
   "then": [
    {
     "to": "var",
     "var": "P20.pass",
     "set": 1
    },
    {
     "to": "flag",
     "key": "has_commission"
    },
    {
     "to": "narration",
     "text": "ヘロンは「街道の山賊討伐」の依頼書をカウンターに叩きつけた。「持っていけ。これがあれば北門は通れる。外でくたばっても、ギルドは死体を拾いに行かんぞ」"
    }
   ],
   "once": true
  },
