  "N201": {
   "class": "npc",
   "name": "ミロ",
   "parent": "D001/D001_R003",
   "props": {
    "summary": "ミラの弟で、探索隊でいちばん若い。モスバロウの第三墓室に閉じ込められている。"
   }
