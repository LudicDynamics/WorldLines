        {
          "flag": "stole.{who}"
        }
      ],
      "on_fail": [
        {
          "var": "town.alert",
          "add": 1
        }
      ],
      "react": "on_fail"
    },
    "recruit": {
      "label": "Invite along",
      "check": null,
      "on_ok": [
        {
          "flag": "joined.{who}"
        }
      ]
    },
    "ask": {
      "label": "Ask around"
    },
    "quest": {
