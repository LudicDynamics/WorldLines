{
 "id": "P20",
 "title": "雾退之夜",
 "stages": [
  {
   "name": "雾期第五夜",
   "goal": {
    "zh": "在镇上打听探路队和北路的事,凑齐出北门要的三样:许可、雾里的路、过驿路的办法。",
    "en": "Ask around town about the scouting party and the north road, and gather the three things the North Gate asks for: leave to pass, a way through the fog, and a way past the post road.",
    "ja": "町で探索隊と北の道のことを聞いて回り、北門を出るのに要る三つ——許し、霧の中の道、街道を抜ける手立て——をそろえる。",
    "ko": "마을에서 정찰대와 북쪽 길에 대해 수소문하고, 북문을 나서는 데 필요한 세 가지——허가, 안개 속의 길, 역로를 지날 방법——를 갖춘다."
   }
  },
  {
   "name": "凑齐三样",
   "goal": {
    "zh": "三样都齐了。把要做的事做完,准备好,等到零点。",
    "en": "All three are in hand. Finish what you must, get ready, and wait for midnight.",
    "ja": "三つともそろった。やるべきことを済ませて備え、零時を待つ。",
    "ko": "세 가지가 모두 갖춰졌다. 할 일을 마치고 채비해서 자정을 기다린다."
   }
  },
  {
   "name": "雾退之夜",
   "goal": {
    "zh": "雾退了。趁路还露着,出北门,沿着那条路去找没回来的人。",
    "en": "The fog has drawn back. While the road lies open, go out by the North Gate and follow it to the ones who never came back.",
    "ja": "霧が退いた。道が見えているうちに北門を出て、その道をたどり、戻らなかった者たちを探す。",
    "ko": "안개가 물러났다. 길이 드러나 있는 동안 북문을 나서, 그 길을 따라 돌아오지 못한 이들을 찾는다."
   }
  },
  {
   "name": "苔墓",
   "goal": {
    "zh": "深入苔墓,把困在里面的人带出来,在雾回来之前回到镇上。",
    "en": "Go deep into Mossbarrow, bring out whoever is trapped inside, and get back to town before the fog returns.",
    "ja": "モスバロウの奥へ進み、閉じ込められた者を連れ出して、霧が戻る前に町へ帰る。",
    "ko": "모스배로 깊숙이 들어가 갇힌 이를 데리고 나와, 안개가 돌아오기 전에 마을로 돌아온다."
   }
  }
 ],
