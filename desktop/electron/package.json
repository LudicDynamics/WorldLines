{
  "name": "worldlines-desktop-electron",
  "version": "0.3.0",
  "private": true,
  "description": "WorldLines desktop shell (Electron candidate) — thin wrapper over `neonrp web`",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ludic-dynamics.worldlines",
    "productName": "WorldLines",
    "files": ["main.cjs", "splash.html"],
    "mac": { "target": "dir", "category": "public.app-category.games" }
  }
}
