worldlines/**/.neonrp/
**/.neonrp/config.json
!neonrp/tests/fixtures/**/.neonrp/config.json

# benchmarks
benchmarks/runs/*

# your own work in the authoring workbench (see CLAUDE.md / AGENTS.md)
