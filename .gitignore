# WorldLines public repository
.DS_Store
.env
.env.*
!.env.example
__pycache__/
*.pyc
.venv/
/dist/
/docs/

# engine (neonrp/)
neonrp/.venv/
neonrp/.pytest_cache/
neonrp/.ruff_cache/
neonrp/src/neonrp/webui/spa/

# product (worldlines/)
worldlines/ui/node_modules/
worldlines/ui/dist/
worldlines/ui/dist-local/
worldlines/ui/dist-hub/
worldlines/ui/*.tsbuildinfo
worldlines/ui/.vite/
worldlines/ui/test-results/
worldlines/ui/playwright-report/
worldlines/desktop/tauri/target/
worldlines/desktop/tauri/gen/
