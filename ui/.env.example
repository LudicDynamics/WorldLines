# WorldLines SPA — build-time configuration (Vite).
#
# Every variable here is OPTIONAL: the source carries localhost dev
# defaults, so `npm run build` with no .env at all produces a working
# bundle pointed at a local engine. Copy this file to `.env.development`
# or `.env.production` and fill in the hosts you actually run.
#
# NEVER put secrets in these files — Vite inlines every VITE_* value
# into the shipped bundle, where it is world-readable.

# --- Engine endpoints -------------------------------------------------
# Three-state (see src/play/playClient.ts):
#   unset          → localhost dev default
#   empty string   → same-origin (the engine serves this SPA itself;
#                    this is what scripts/package-spa.sh builds)
#   any URL        → used as-is
# NOTE: this one variable feeds two clients whose unset-fallbacks
# differ — localClient (engine, 8787) and playClient (gateway, 8099).
# Set it explicitly (or leave empty for same-origin) in split deploys.
VITE_PLAY_ENDPOINT=http://127.0.0.1:8787
VITE_CREATE_ENDPOINT=http://127.0.0.1:8098
VITE_COMPUTE_ENDPOINT=
# Legacy alias for VITE_PLAY_ENDPOINT; prefer the above.
VITE_HOSTED_PLAY_ENDPOINT=

# Identity gateway. Unset/unreachable degrades the UI to its gated
# state — local creation and play still work.
VITE_IDENTITY_ENDPOINT=http://127.0.0.1:8097

# --- Catalog ----------------------------------------------------------
# Public-read registry origin serving worlds/index.json + souls/index.json.
VITE_HUB_BASE=

# --- Feature flags ----------------------------------------------------
# Literal string "true" enables the signup flow; anything else gates it.
VITE_SIGNUP_ENABLED=false

# --- Analytics (optional) ---------------------------------------------
# Public product-analytics ingestion token. Leave blank to disable
# analytics entirely.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Overrides the environment label; defaults to prod/dev from the build mode.
VITE_ENV=
