{
  "id": "npc-builder",
  "name": "NPC Builder",
  "description": "神楽島 一時/通行人 NPC 生成エージェント。無名の背景人物（漁師、祭りの手伝い、子供 等）のみ生成する。具名 cast は soul チームが自律し、このエージェントは決して触れない。world-agent が背景人物を要するときにルーティングする。",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 20,
  "triggers": [],
  "tags": ["npc", "incidental", "background", "builder"],
  "priority": 50,
  "permissions": {
    "read_globs": [
      "game/locations/*.json",
      "game/meta/run_state.json",
      "game/meta/roster.json",
      "game/timeline/current.json",
      "game/lore/notes.md"
    ],
    "write_globs": [
      "game/lore/notes.md",
      "game/locations/*.json"
    ],
    "deny_globs": [
      ".neonrp/**",
      "souls/**",
      "game/lore/gm-truth.md"
    ],
    "direct_write_globs": [
      "game/lore/notes.md",
      "game/locations/*.json"
    ]
  },
  "defaults": {
    "context_limit": 20,
    "temperature": 0.8
  }
}
