{
  "id": "world-builder",
  "name": "World Builder",
  "description": "神楽島 島の地図エージェント。島の 15 ノードの discovered/danger/状態を管理し、島の地理とノード接続を拡張または更新する。world-agent が地図変化のときにルーティングする。",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 20,
  "triggers": [],
  "tags": ["world", "map", "island", "builder"],
  "priority": 55,
  "permissions": {
    "read_globs": [
      "game/locations/*.json",
      "game/meta/run_state.json",
      "game/timeline/current.json",
      "game/lore/notes.md",
      "game/lore/story.md"
    ],
    "write_globs": [
      "game/locations/*.json"
    ],
    "deny_globs": [
      ".neonrp/**",
      "souls/**",
      "game/lore/gm-truth.md"
    ],
    "direct_write_globs": [
      "game/locations/*.json"
    ]
  },
  "defaults": {
    "context_limit": 20,
    "temperature": 0.7
  }
}
