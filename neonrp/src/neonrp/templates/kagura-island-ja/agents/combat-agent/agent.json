{
  "id": "combat-agent",
  "name": "Combat / Crisis Agent",
  "description": "神楽島 危機/衝突の裁定エージェント（ダンジョン戦闘ではない）。悠人の覚醒による最近者への攻撃、肉体的衝突、危険、そして翼の失血・応急手当の時限の切迫性を裁定する。world-agent が危機の場面でルーティングする。",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 20,
  "triggers": [],
  "tags": ["crisis", "conflict", "danger", "injury", "referee"],
  "priority": 65,
  "permissions": {
    "read_globs": [
      "game/meta/run_state.json",
      "game/timeline/current.json",
      "game/locations/*.json",
      "game/lore/notes.md"
    ],
    "write_globs": [
      "game/meta/run_state.json",
      "game/lore/notes.md"
    ],
    "deny_globs": [
      ".neonrp/**",
      "souls/**",
      "game/lore/gm-truth.md"
    ],
    "direct_write_globs": [
      "game/meta/run_state.json",
      "game/lore/notes.md"
    ]
  },
  "defaults": {
    "context_limit": 20,
    "temperature": 0.7
  }
}
