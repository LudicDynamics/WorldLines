{
  "id": "rules-referee",
  "name": "Rules Referee",
  "description": "規則裁定者。非戦闘のダイス判定、常識チェック、行為の適合性判定を処理する。プレイヤーが不確実なことや常識を逸脱したことをしたとき world-agent から呼ばれる。",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 15,
  "triggers": [],
  "tags": [
    "rules",
    "dice",
    "sanity",
    "skill-check"
  ],
  "priority": 70,
  "permissions": {
    "read_globs": [
      "game/player/stats.json",
      "game/player/profile.json",
      "game/player/equipment.json",
      "game/player/flags.json",
      "game/rules/**",
      "game/meta/run_state.json"
    ],
    "write_globs": [],
    "deny_globs": [
      ".neonrp/**"
    ],
    "direct_write_globs": []
  },
  "defaults": {
    "context_limit": 15,
    "temperature": 0.3
  },
  "presentation_roles": {
    "en": "Rules",
    "zh": "规则",
    "ja": "ルール",
    "ko": "규칙"
  },
  "presentation_hidden": false
}
