          "世界の果て",
          "洞穴"
        ]
      }
    },
    {
      "id": "mossbarrow",
      "text": "苔墓の地下墓は町の外にあり、しゃべる棺があるという噂だ。",
      "when": {
        "keyword": [
          "苔墓",
          "棺",
          "地下墓"
        ]
      }
    }
