{
  "data_dir": "{{DATA_DIR}}",
  "router": {
    "agent_id": "narrator",
    "state_file": "meta/active-agent.json",
    "startup_file": "meta/game-start.json",
    "execution_mode": "multi-agent"
  },
  "surface_modes": {
    "web": "multi-agent",
    "tui": "orchestrator"
  },
  "surface_mode_routers": {
    "multi-agent": "narrator",
    "orchestrator": "world-agent"
  },
  "routing": {
    "location_source": {
      "entity_id": "player",
      "field": "location"
    },
    "domain_agent_map": {},
    "fallback_agent": "narrator"
  },
  "context_pack": {
    "seed_entity_ids": [
      "player",
      "active-agent",
      "game-start"
    ],
    "max_entities": 6
  }
}
