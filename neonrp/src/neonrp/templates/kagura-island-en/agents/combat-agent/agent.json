{
  "id": "combat-agent",
  "name": "Combat / Crisis Agent",
  "description": "Kagura Island crisis/conflict adjudication agent (not dungeon combat). Adjudicates Yuto waking and attacking the nearest person, physical conflict, danger, and the time-pressure urgency of first aid for Tsubasa's blood loss. Routed by world-agent in crisis scenes.",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 20,
  "triggers": [],
  "tags": ["crisis", "conflict", "danger", "injury", "referee"],
  "priority": 65,
  "permissions": {
    "read_globs": [
      "game/meta/run_state.json",
      "game/timeline/current.json",
      "game/locations/*.json",
      "game/lore/notes.md"
    ],
    "write_globs": [
      "game/meta/run_state.json",
      "game/lore/notes.md"
    ],
    "deny_globs": [
      ".neonrp/**",
      "souls/**",
      "game/lore/gm-truth.md"
    ],
    "direct_write_globs": [
      "game/meta/run_state.json",
      "game/lore/notes.md"
    ]
  },
  "defaults": {
    "context_limit": 20,
    "temperature": 0.7
  }
}
