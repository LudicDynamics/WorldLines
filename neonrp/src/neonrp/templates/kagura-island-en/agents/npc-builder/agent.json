{
  "id": "npc-builder",
  "name": "NPC Builder",
  "description": "Kagura Island temporary/passerby NPC generation agent. Generates only unnamed background figures (fishermen, festival hands, children, etc.). The named cast is autonomous via the soul team; this agent never touches them. Routed by world-agent when background figures are needed.",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 20,
  "triggers": [],
  "tags": ["npc", "incidental", "background", "builder"],
  "priority": 50,
  "permissions": {
    "read_globs": [
      "game/locations/*.json",
      "game/meta/run_state.json",
      "game/meta/roster.json",
      "game/timeline/current.json",
      "game/lore/notes.md"
    ],
    "write_globs": [
      "game/lore/notes.md",
      "game/locations/*.json"
    ],
    "deny_globs": [
      ".neonrp/**",
      "souls/**",
      "game/lore/gm-truth.md"
    ],
    "direct_write_globs": [
      "game/lore/notes.md",
      "game/locations/*.json"
    ]
  },
  "defaults": {
    "context_limit": 20,
    "temperature": 0.8
  }
}
