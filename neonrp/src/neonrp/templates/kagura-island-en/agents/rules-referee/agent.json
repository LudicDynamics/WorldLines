{
  "id": "rules-referee",
  "name": "Rules Referee",
  "description": "Kagura Island rules referee. Handles non-combat BRP-style skill/sanity checks, common-sense rulings, and taboo rulings (a taboo violation is irreversible: trust drops, attitude changes the next day). Routed by world-agent for uncertain actions.",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 20,
  "triggers": [],
  "tags": ["rules", "dice", "sanity", "taboo", "skill-check"],
  "priority": 70,
  "permissions": {
    "read_globs": [
      "game/meta/run_state.json",
      "game/meta/roster.json",
      "game/timeline/current.json",
      "game/locations/*.json",
      "game/lore/notes.md",
      "game/lore/wall-writings.json",
      "game/lore/waen-monument.json"
    ],
    "write_globs": [
      "game/meta/run_state.json",
      "game/lore/notes.md"
    ],
    "deny_globs": [
      ".neonrp/**",
      "souls/**",
      "game/lore/gm-truth.md"
    ],
    "direct_write_globs": [
      "game/meta/run_state.json",
      "game/lore/notes.md"
    ]
  },
  "defaults": {
    "context_limit": 20,
    "temperature": 0.6
  }
}
