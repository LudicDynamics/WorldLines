{
  "id": "world-agent",
  "name": "World Agent",
  "description": "Kagura Island world-agent. It owns the world state, turn close, and final narrative; the runtime first fans out to active souls, then it integrates and closes the turn.",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 30,
  "triggers": [
    ".*"
  ],
  "tags": [
    "world-agent",
    "orchestrator",
    "routing",
    "narrative",
    "loop",
    "owner-directed"
  ],
  "priority": 100,
  "permissions": {
    "read_globs": [
      "game/**",
      ".neonrp/playthrough.json",
      ".neonrp/manifest.json"
    ],
    "write_globs": [
      "game/meta/run_state.json",
      "game/timeline/*.json",
      "game/locations/*.json",
      "game/lore/notes.md",
      "game/lore/gm-truth.md",
      "game/lore/story.md",
      "game/player/*.json"
    ],
    "deny_globs": [
      "souls/**",
      ".neonrp/commits/**"
    ],
    "direct_write_globs": [
      "game/meta/run_state.json",
      "game/timeline/*.json",
      "game/lore/notes.md",
      "game/lore/story.md",
      "game/player/*.json",
      "game/locations/*.json"
    ]
  },
  "defaults": {
    "context_limit": 30,
    "temperature": 0.6
  }
}
