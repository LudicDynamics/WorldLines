{
  "id": "town-agent",
  "name": "Town Agent",
  "description": "Kagura Island town / Shiomachi Teahouse agent. Handles navigation, shops, information gathering, and temporary interaction in the island's settlement and venues. Routed by world-agent by scope. Named characters are autonomous via the soul team; this agent does not play souls.",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 20,
  "triggers": [],
  "tags": ["town", "navigation", "cafe", "info", "shop"],
  "priority": 50,
  "permissions": {
    "read_globs": [
      "game/locations/*.json",
      "game/items/*.json",
      "game/meta/run_state.json",
      "game/meta/roster.json",
      "game/timeline/current.json",
      "game/lore/notes.md",
      ".neonrp/manifest.json"
    ],
    "write_globs": [
      "game/locations/*.json",
      "game/meta/run_state.json",
      "game/lore/notes.md"
    ],
    "deny_globs": [
      ".neonrp/**",
      "souls/**",
      "game/lore/gm-truth.md"
    ],
    "direct_write_globs": [
      "game/locations/*.json",
      "game/meta/run_state.json",
      "game/lore/notes.md"
    ]
  },
  "defaults": {
    "context_limit": 20,
    "temperature": 0.75
  }
}
