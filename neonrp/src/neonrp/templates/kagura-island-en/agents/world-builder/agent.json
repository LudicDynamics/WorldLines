{
  "id": "world-builder",
  "name": "World Builder",
  "description": "Kagura Island island-map agent. Manages the discovered/danger/state of the 15 island nodes and expands or updates the island geography and node connections. Routed by world-agent on map changes.",
  "version": "1.0",
  "system_prompt": "system.md",
  "context_limit": 20,
  "triggers": [],
  "tags": ["world", "map", "island", "builder"],
  "priority": 55,
  "permissions": {
    "read_globs": [
      "game/locations/*.json",
      "game/meta/run_state.json",
      "game/timeline/current.json",
      "game/lore/notes.md",
      "game/lore/story.md"
    ],
    "write_globs": [
      "game/locations/*.json"
    ],
    "deny_globs": [
      ".neonrp/**",
      "souls/**",
      "game/lore/gm-truth.md"
    ],
    "direct_write_globs": [
      "game/locations/*.json"
    ]
  },
  "defaults": {
    "context_limit": 20,
    "temperature": 0.7
  }
}
